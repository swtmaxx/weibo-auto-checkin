# Keep this value stable. It encrypts the stored Weibo Cookie.
APP_SECRET_KEY=replace-with-a-long-random-value

# The defaults are relative to this project directory.
APP_DATA_DIR=./data
APP_HOST=0.0.0.0
APP_PORT=8000

# Set true only when serving through HTTPS.
APP_COOKIE_SECURE=false

# These are fallback defaults. Values saved from the WebUI take precedence.
APP_TIMEZONE=Asia/Shanghai
APP_CHECKIN_DELAY_SECONDS=10.0
# Actual wait = base delay scaled by a random factor within +/- this percent.
APP_DELAY_JITTER_PERCENT=25
APP_MAX_TOPICS_PER_RUN=0
APP_MAX_CONSECUTIVE_FAILURES=3
APP_REQUEST_TIMEOUT_SECONDS=15
APP_READ_RETRY_COUNT=1
APP_COOLDOWN_ON_RATE_LIMIT=true
# 0 = cool down until next local midnight; 1-168 = fixed number of hours.
APP_COOLDOWN_HOURS=0

# Delete run history older than this many days (0 keeps everything).
APP_HISTORY_RETENTION_DAYS=90

# true: a missed daily run still fires later the same day after restart.
# false: only run within the scheduled minute.
APP_SCHEDULE_CATCH_UP=true
# After the scheduled time, wait a random 0..N minutes before firing (0 = exact).
APP_SCHEDULE_JITTER_MINUTES=0

# Failed login attempts are throttled with an increasing delay per client IP.

# QQ Bot AppID, ClientSecret and event listening are configured in the WebUI.
