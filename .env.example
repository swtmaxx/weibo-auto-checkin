# Keep this value stable. It encrypts the stored Weibo Cookie.
APP_SECRET_KEY=replace-with-a-long-random-value

# The defaults are relative to this project directory.
APP_DATA_DIR=./data
APP_HOST=0.0.0.0
APP_PORT=8000

# Set true only when serving through HTTPS.
APP_COOKIE_SECURE=false

# These are fallback defaults. Values saved from the WebUI take precedence.
APP_TIMEZONE=Asia/Shanghai
APP_CHECKIN_DELAY_SECONDS=10.0
APP_MAX_TOPICS_PER_RUN=0
APP_MAX_CONSECUTIVE_FAILURES=3
APP_REQUEST_TIMEOUT_SECONDS=15
APP_READ_RETRY_COUNT=1
APP_COOLDOWN_ON_RATE_LIMIT=true

# QQ Bot AppID, ClientSecret and event listening are configured in the WebUI.
